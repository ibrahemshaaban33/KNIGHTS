<script>
  (function() {
    const searchInput = document.getElementById('memberSearchInput');
    const memberCards = document.querySelectorAll('.member-card');
    const filterButtons = document.querySelectorAll('.roster-filter-btn');

    let currentFilter = 'all';
    let currentSearch = '';

    function applyFilterAndSearch() {
      memberCards.forEach(card => {
        const name = (card.dataset.name || '').toLowerCase();
        const power = parseFloat(card.dataset.power || '0');
        
        let matchesFilter = true;
        if (currentFilter === 'billion') {
          matchesFilter = power >= 1000;
        } else if (currentFilter === 'elite') {
          matchesFilter = power >= 600 && power < 1000;
        } else if (currentFilter === 'legion') {
          matchesFilter = power >= 500 && power < 600;
        } else if (currentFilter === 'vanguard') {
          matchesFilter = power < 500;
        }

        const matchesSearch = !currentSearch || name.includes(currentSearch);

        if (matchesFilter && matchesSearch) {
          card.classList.remove('hidden');
          card.classList.add('flex');
        } else {
          card.classList.add('hidden');
          card.classList.remove('flex');
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = e.target.value.trim().toLowerCase();
        applyFilterAndSearch();
      });
    }

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('bg-primary-container', 'text-on-primary-container');
          b.classList.add('bg-surface-container-high', 'text-on-surface-variant');
        });

        btn.classList.add('bg-primary-container', 'text-on-primary-container');
        btn.classList.remove('bg-surface-container-high', 'text-on-surface-variant');

        currentFilter = btn.dataset.filter;
        applyFilterAndSearch();
      });
